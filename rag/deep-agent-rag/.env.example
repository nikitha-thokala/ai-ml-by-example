# Copy this file to .env and fill in your keys. .env is in .gitignore, so it never gets committed.

# LLM for the deep agent (default model: openai:gpt-4o)
OPENAI_API_KEY=

# LangSmith tracing: create a key at https://smith.langchain.com → Settings → API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-agent-rag

# Optional: use a different model, e.g. Claude (also run: pip install langchain-anthropic)
# AGENT_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=
